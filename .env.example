APP_ENV=development
PORT=8080
DATABASE_URL=postgres://yourclerk:yourclerk@localhost:5432/yourclerk?sslmode=disable
TEST_DATABASE_URL=postgres://yourclerk:yourclerk@localhost:5432/yourclerk?sslmode=disable
SMTP_ADDR=localhost:1025
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
# Public URL of this service; goes into the "iss" claim of access tokens.
ISSUER=http://localhost:8080
# Swagger UI at /docs. Defaults to on in development, off elsewhere.
ENABLE_DOCS=true
