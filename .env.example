APP_ENV=development
PORT=8080
DATABASE_URL=postgres://yourclerk:yourclerk@localhost:5432/yourclerk?sslmode=disable
TEST_DATABASE_URL=postgres://yourclerk:yourclerk@localhost:5432/yourclerk?sslmode=disable
SMTP_ADDR=localhost:1025
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
# Public base URL of this service. Each application's tokens get the issuer
# "<ISSUER>/apps/<application id>" and its keys live under that URL.
ISSUER=http://localhost:8080
# Swagger UI at /docs. Defaults to on in development, off elsewhere.
ENABLE_DOCS=true

# --- Email (Stage 5) ---
# log     print emails (with their links) in the server log; development only
# smtp    send through SMTP_ADDR; Mailpit locally (web UI http://localhost:8025)
# resend  send through the Resend HTTP API (needs RESEND_API_KEY)
MAIL_DRIVER=log
MAIL_FROM=YourClerk <no-reply@localhost>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# The front end that handles the links in emails:
#   WEB_URL/verify-email#token=...   WEB_URL/reset-password#token=...
WEB_URL=http://localhost:3000
